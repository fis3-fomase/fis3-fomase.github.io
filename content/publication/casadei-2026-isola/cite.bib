 _url = {https://doi.org/10.1007/978-3-032-40108-3_13},
 abstract = {Emerging paradigms such as the Internet of Things (IoT), Cyber-Physical Systems, and Wireless Sensor Networks envision distributed computing platforms as dense deployments of interacting devices embedded within physical environments (e.g., agricultural fields, smart cities, traffic systems). To effectively engineer these systems, we must shift our focus from individual devices to the collective behaviour of the ensemble, designing distributed algorithms from a global perspective. Many of these algorithms produce a collective result—a computational field of values distributed across space and time—that converges as device density and execution speed approach infinity. Consequently, the behaviour of such algorithms can be formally captured by computational fields defined over continuous domains: deployment on a discrete network simply leads to an approximation over the ideal continuous behaviour. In this paper, we define a formal framework to capture this idea, and accordingly characterise some fundamental algorithms of collective adaptive behaviour.},
 author = {Casadei,  Roberto and Viroli,  Mirko and Castronuovo,  Niccolò and Aguzzi,  Gianluca},
 booktitle = {Leveraging Applications of Formal Methods, Verification and Validation (ISoLA 2026)},
 doi = {10.1007/978-3-032-40108-3_13},
 editor = {Margaria,  Tiziana and Steffen,  Bernhard},
 keywords = { fomase },
 pages = {218-233},
 publisher = {Springer Nature Switzerland},
 series = {Lecture Notes in Computer Science},
 title = {A Specification Approach for Distributed Algorithms in Continuous Space-Time},
 volume = {17141},
 year = {2026}
}
